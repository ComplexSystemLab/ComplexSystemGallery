{
  "name": "complex-system-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --dir ../main-ui build",
    "gen:tree": "node scripts/build-project-tree.mjs",
    "sync:demo-vendor": "node scripts/sync-demo-vendor.mjs",
    "predev": "pnpm build:deps && pnpm sync:demo-vendor && pnpm gen:tree",
    "dev": "vite",
    "prebuild": "pnpm build:deps && pnpm sync:demo-vendor && pnpm gen:tree",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@main-ui/core": "workspace:*",
    "@main-ui/view-console": "workspace:*",
    "@main-ui/view-form": "workspace:*",
    "@main-ui/view-host-engine": "workspace:*",
    "@main-ui/view-sandbox": "workspace:*",
    "@main-ui/view-table": "workspace:*",
    "@main-ui/view-tree": "workspace:*",
    "@main-ui/viewport-2d-kit": "workspace:*",
    "main-ui": "workspace:^0.6.0",
    "p5": "^1.11.11",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "sirv": "^3.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
